---
import { abs, staticRoutes, url, type Lang } from '../lib/routes';
import { ui } from '../i18n/copy';
import type { Page } from '../lib/projects';
interface Props { page: Page; logo: string }
const { page, logo } = Astro.props;
const lang: Lang = page.lang;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'nl' : 'en';
const links = [
  { key: 'projects', label: t.navProjects, match: ['projects', 'project'] },
  { key: 'services', label: t.navServices, match: ['services', 'service-concept', 'service-technical', 'service-turnkey'] },
  { key: 'approach', label: t.navApproach, match: ['approach'] },
  { key: 'contact', label: t.navContact, match: ['contact', 'thanks'] },
] as const;
---
<header class="header" data-header>
  <div class="wrap">
    <a class="logo" href={url(staticRoutes.home[lang])} aria-label={`CuttingEdge, ${t.navHome}`}>
      <img src={logo} alt="" width="93" height="44" />
    </a>
    <nav class="nav" id="site-nav" aria-label={t.navLabel} data-nav>
      <ul>
        {links.map((l) => (
          <li><a href={url(staticRoutes[l.key][lang])} aria-current={(l.match as readonly string[]).includes(page.key) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header__tools">
      <a class="lang" href={url(page.paths[other])} hreflang={other} lang={other} aria-label={t.langAria}>{other}</a>
      <a class="btn" href={url(staticRoutes.contact[lang])}>{t.cta}</a>
    </div>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={t.menu} data-menu>
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
